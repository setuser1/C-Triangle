using "string_x86"
expose string_impl_x86@string_x86

int strcmp(string a, string b) {
    return __strcmp_asm@string_impl_x86(a, b);
}

string strcpy(string dest, string src) {
    return __strcpy_asm@string_impl_x86(dest, src);
}

string strcat(string dest, string src) {
    return __strcat_asm@string_impl_x86(dest, src);
}

string strdup(string s) {
    return __strdup_asm@string_impl_x86(s);
}

int strchr(string s, char c) {
    return __strchr_asm@string_impl_x86(s, c);
}

int strstr(string haystack, string needle) {
    return __strstr_asm@string_impl_x86(haystack, needle);
}

int strlen(string s) {
    return __strlen_asm@string_impl_x86(s);
}

string strncpy(string dest, string src, int n) {
    return __strncpy_asm@string_impl_x86(dest, src, n);
}

string strncat(string dest, string src, int n) {
    return __strncat_asm@string_impl_x86(dest, src, n);
}

int strncmp(string a, string b, int n) {
    return __strncmp_asm@string_impl_x86(a, b, n);
}