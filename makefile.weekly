.PHONY: install

PYINSTALLER_NAME := hypotenuse

# ---------------------------------------------------------------
# install: create the library directories and copy the packaged files
#          to global locations if available, otherwise use local paths.
# ---------------------------------------------------------------
install:
	@if [ -w /usr/local/bin ]; then \
		mkdir -p /usr/local/bin; \
		sudo mkdir -p /usr/lib/PLIBS; \
		cp ./$(PYINSTALLER_NAME) /usr/local/bin/$(PYINSTALLER_NAME); \
		chmod +x /usr/local/bin/$(PYINSTALLER_NAME); \
		cp -r ./bracket /usr/lib/PLIBS/; \
		echo "Installed to /usr/local/bin/$(PYINSTALLER_NAME) and /usr/lib/PLIBS"; \
	else \
		mkdir -p ~/.local/bin; \
		mkdir -p ~/.local/lib/PLIBS; \
		cp ./$(PYINSTALLER_NAME) ~/.local/bin/$(PYINSTALLER_NAME); \
		chmod +x ~/.local/bin/$(PYINSTALLER_NAME); \
		cp -r ./bracket ~/.local/lib/PLIBS/; \
		echo "Installed to ~/.local/bin/$(PYINSTALLER_NAME) and ~/.local/lib/PLIBS"; \
	fi
