{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Compile i++ File",
      "command": "${config:ctriangle.compilerPath}",
      "args": [
        "-c",
        "${file}"
      ],
      "problemMatcher": [],
      "group": "build",
      "detail": "Compile the current i++ file with hypotenuse"
    },
    {
      "type": "shell",
      "label": "Run i++ File",
      "command": "${fileDirname}/${fileBasenameNoExtension}",
      "args": [],
      "problemMatcher": [],
      "group": "test",
      "dependsOn": ["Compile i++ File"],
      "detail": "Run the compiled executable"
    },
    {
      "type": "shell",
      "label": "Build VSIX Extension",
      "command": "vsce package",
      "args": [],
      "problemMatcher": [],
      "group": "build",
      "dependsOn": ["Compile TypeScript"],
      "detail": "Package the VSIX extension"
    },
    {
      "type": "shell",
      "label": "Compile TypeScript",
      "command": "npx tsc -p ./tsconfig.json",
      "args": [],
      "problemMatcher": [],
      "group": "build",
      "detail": "Compile TypeScript for VSIX extension"
    },
    {
      "type": "shell",
      "label": "Debug with GDB",
      "command": "gdb",
      "args": [
        "-q",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "problemMatcher": [],
      "group": "debug",
      "dependsOn": ["Compile i++ File"],
      "detail": "Debug the compiled executable with GDB"
    }
  ]
}