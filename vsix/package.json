{
  "name": "ctriangle",
  "displayName": "i++",
  "description": "Language support for i++ - a C superset with namespaces, dynamic arrays, and first-class strings",
  "version": "1.0.0",
  "publisher": "ctriangle",
  "engines": {
    "vscode": "^1.70.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:ctriangle"
  ],
  "scripts": {
    "compile": "tsc -p ./tsconfig.json",
    "package": "vsce package"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ctriangle",
        "aliases": ["i++"],
        "extensions": [".ix", ".ih"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ctriangle",
        "scopeName": "source.ctriangle",
        "path": "./syntaxes/ctriangle.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "ctriangle-icons",
        "label": "i++ Icons",
        "path": "./icons/ctriangle-icon-theme.json"
      }
    ],
    "tasks": {
      "version": "2.0.0",
      "tasks": [
        {
          "type": "shell",
          "label": "Compile i++ File",
          "command": "hypotenuse",
          "args": ["-c", "${file}"],
          "problemMatcher": [],
          "group": "build",
          "detail": "Compile the current i++ file to executable"
        },
        {
          "type": "shell",
          "label": "Run i++ File",
          "command": "${fileDirname}/${fileBasenameNoExtension}",
          "problemMatcher": [],
          "group": "test",
          "dependsOn": ["Compile i++ File"],
          "detail": "Run the compiled executable"
        }
      ]
    }
  },
  "icon": "assets/logo.png"
}
