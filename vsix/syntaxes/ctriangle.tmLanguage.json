{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "i++",
  "patterns": [
    { "include": "#comments" },
    { "include": "#preprocessor" },
    { "include": "#strings" },
    { "include": "#imports" },
    { "include": "#deprecated" },
    { "include": "#ctri-keywords" },
    { "include": "#types" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#namespace-access" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.ippangle",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.ippangle",
          "begin": "//",
          "end": "$"
        }
      ]
    },
    "preprocessor": {
      "name": "meta.preprocessor.ippangle",
      "match": "^\\s*(#\\s*(?:include|define|undef|ifdef|ifndef|if|elif|else|endif|pragma|error|warning|line))\\b(.*)",
      "captures": {
        "1": { "name": "keyword.control.directive.ippangle" },
        "2": { "name": "string.unquoted.preprocessor.ippangle" }
      }
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ippangle",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.ippangle", "match": "\\\\." },
            { "name": "constant.other.format-specifier.ippangle", "match": "%[diouxXeEfFgGcspk%]" }
          ]
        },
        {
          "name": "string.quoted.single.ippangle",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.ippangle", "match": "\\\\." }
          ]
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "comment": "using \"plstd/module\" — import a plstd module by path",
          "name": "meta.import.path.ippangle",
          "match": "\\b(using)\\s+(\"[^\"]+\")",
          "captures": {
            "1": { "name": "keyword.control.import.ippangle" },
            "2": { "name": "string.quoted.double.import.ippangle" }
          }
        },
        {
          "comment": "using <lib> — import all from a system library",
          "name": "meta.import.all.ippangle",
          "match": "\\b(using)\\s+(<[^>]+>)",
          "captures": {
            "1": { "name": "keyword.control.import.ippangle" },
            "2": { "name": "string.quoted.other.import.ippangle" }
          }
        },
        {
          "comment": "using name from <lib> or \"lib\" — import a named symbol",
          "name": "meta.import.from.ippangle",
          "match": "\\b(using)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(from)\\s+(\"[^\"]+\"|<[^>]+>)",
          "captures": {
            "1": { "name": "keyword.control.import.ippangle" },
            "2": { "name": "entity.name.import.symbol.ippangle" },
            "3": { "name": "keyword.control.import.ippangle" },
            "4": { "name": "string.quoted.double.import.ippangle" }
          }
        },
        {
          "comment": "using scope&var — intra-file immutable reference to a scoped variable",
          "name": "meta.import.scope.ippangle",
          "match": "\\b(using)\\s+([A-Za-z_][A-Za-z0-9_]*)(&)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.import.ippangle" },
            "2": { "name": "entity.name.scope.ippangle" },
            "3": { "name": "keyword.operator.ippangle" },
            "4": { "name": "variable.other.ippangle" }
          }
        },
        {
          "comment": "expose lib@module — globalizes one module from a library into the current scope",
          "name": "meta.expose.module.ippangle",
          "match": "\\b(expose)\\s+([A-Za-z_][A-Za-z0-9_]*)(@)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.expose.ippangle" },
            "2": { "name": "entity.name.namespace.ippangle" },
            "3": { "name": "keyword.operator.namespace.ippangle" },
            "4": { "name": "entity.name.module.ippangle" }
          }
        },
        {
          "comment": "expose name — globalizes an entire library or namespace into the current scope",
          "name": "meta.expose.ippangle",
          "match": "\\b(expose)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.expose.ippangle" },
            "2": { "name": "entity.name.namespace.ippangle" }
          }
        },
        {
          "comment": "space name — declares a named namespace block in a .ih library file",
          "name": "meta.namespace.ippangle",
          "match": "\\b(space)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.namespace.ippangle" },
            "2": { "name": "entity.name.namespace.ippangle" }
          }
        }
      ]
    },
    "deprecated": {
      "comment": "C11 keywords removed in i++ — flagged as invalid",
      "name": "invalid.deprecated.ippangle",
      "match": "\\b(restrict|_Bool|_Complex|_Imaginary)\\b"
    },
    "ctri-keywords": {
      "patterns": [
        {
          "comment": "i++ import/module keywords active in current build",
          "name": "keyword.control.ippangle",
          "match": "\\b(using|expose|from|as|space|namespace|overwrite)\\b"
        },
        {
          "comment": "i++ memory and structure keywords active in current build",
          "name": "keyword.declaration.ippangle",
          "match": "\\b(allocate|autoremove|free|asm|self|init|end)\\b"
        },
        {
          "comment": "i++ future keywords — planned but not yet implemented",
          "name": "keyword.other.future.ippangle",
          "match": "\\b(auto|dynam|tuple|typed|string|lamb|Typed|Worded)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.ippangle",
          "match": "\\b(int|char|void|float|double|short|long|signed|unsigned|size_t|struct|union|enum|typedef)\\b"
        },
        {
          "name": "storage.modifier.ippangle",
          "match": "\\b(const|volatile|inline|register)\\b"
        },
        {
          "name": "storage.class.ippangle",
          "match": "\\b(static|extern)\\b"
        },
        {
          "name": "storage.type.custom.ippangle",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "name": "keyword.control.c11.ippangle",
      "match": "\\b(if|else|while|for|do|switch|case|default|break|continue|return|goto|sizeof|_Noreturn|_Generic|_Alignof|_Alignas)\\b"
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.ippangle", "match": "\\b0[xX][0-9a-fA-F]+[uUlL]*\\b" },
        { "name": "constant.numeric.binary.ippangle", "match": "\\b0[bB][01]+[uUlL]*\\b" },
        { "name": "constant.numeric.float.ippangle", "match": "\\b\\d+\\.\\d+[fFlL]?\\b" },
        { "name": "constant.numeric.integer.ippangle", "match": "\\b\\d+[uUlL]*\\b" }
      ]
    },
    "namespace-access": {
      "comment": "func@namespace — explicit access to a member of a namespace or plstd module",
      "name": "meta.namespace.access.ippangle",
      "match": "([A-Za-z_][A-Za-z0-9_]*)(@)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "entity.name.function.ippangle" },
        "2": { "name": "keyword.operator.namespace.ippangle" },
        "3": { "name": "entity.name.namespace.ippangle" }
      }
    },
    "operators": {
      "patterns": [
        {
          "comment": "Bitwise NOT operator — ~ is NOT a namespace accessor in i++",
          "name": "keyword.operator.bitwise.ippangle",
          "match": "~"
        },
        {
          "comment": "@ is the namespace accessor operator",
          "name": "keyword.operator.namespace.ippangle",
          "match": "@"
        },
        { "name": "keyword.operator.comparison.ippangle", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.logical.ippangle", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.assignment.ippangle", "match": "\\+=|-=|\\*=|/=|%=|=" },
        { "name": "keyword.operator.arithmetic.ippangle", "match": "\\+\\+|--|\\*\\*|\\+|-|\\*|/|%" },
        { "name": "keyword.operator.bitwise.ippangle", "match": "<<|>>|&|\\||\\^" },
        { "name": "keyword.operator.pointer.ippangle", "match": "->|\\*(?=[A-Za-z_])|&(?=[A-Za-z_])" },
        { "name": "keyword.operator.ternary.ippangle", "match": "\\?" }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "support.function.plstd.ippangle",
          "match": "\\b(printd|printfs|len)\\b"
        },
        {
          "name": "variable.other.ippangle",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "entity.name.function.ippangle",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\s*(?=\\()"
        }
      ]
    }
  },
  "scopeName": "source.ippangle"
}
